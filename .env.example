# ─────────────────────────────────────────────────────────────
# Zauq e Zaika — environment variables
# Copy to `.env` (local) and set the same names in Vercel (production).
# NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL — Supabase: Project Settings → Database → Connection string
# DATABASE_URL = pooled connection (port 6543, add ?pgbouncer=true)
# DIRECT_URL   = direct connection (port 5432), used for migrations
# Local dev (npm run db:local): both = postgresql://postgres:postgres@localhost:5433/zauqezaika
DATABASE_URL=""
DIRECT_URL=""

# Initial admin account created by `npm run db:seed` (change the password after first login)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Zauq e Zaika Admin"

# ─── Image storage ───
# "local" saves uploads to /public/uploads (development only — not persistent on Vercel)
# "supabase" uses Supabase Storage (recommended for production)
STORAGE_DRIVER="local"
SUPABASE_URL=""
# Server-only secret. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="media"

# ─── Payments (Razorpay) ───
# Leave empty to keep online payments disabled. Use rzp_test_ keys first.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ─── Optional: YouTube Data API (auto-import latest videos in admin) ───
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""
